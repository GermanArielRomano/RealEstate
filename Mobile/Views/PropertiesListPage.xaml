<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RealEstate.Mobile.ViewModels"
             xmlns:models="clr-namespace:RealEstate.Mobile.Models"
             x:Class="RealEstate.Mobile.Views.PropertiesListPage"
             x:DataType="vm:PropertiesListViewModel"
             Title="Propiedades"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}">

    <ContentPage.Resources>
        <Color x:Key="Primary">#1D6FEA</Color>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Margin" Value="16,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E22}" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.12" Radius="10" Offset="0,4" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Banner de error con reintento (la lista cargada se conserva debajo) -->
        <Border Grid.Row="0"
                IsVisible="{Binding HasError}"
                Margin="16,12,16,0"
                Padding="12"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light=#FDECEA, Dark=#3B1F1D}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding ErrorMessage}"
                       FontSize="14"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
                <Button Grid.Column="1"
                        Text="Reintentar"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="36"
                        Padding="14,0"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <!-- Pull-to-refresh + lista virtualizada con paginación infinita -->
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource Primary}">

            <CollectionView ItemsSource="{Binding Properties}"
                            SelectionMode="None"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout x:DataType="vm:PropertiesListViewModel"
                                         IsVisible="{Binding IsEmpty}"
                                         Padding="32,96"
                                         Spacing="8"
                                         HorizontalOptions="Center">
                        <Label Text="🏠" FontSize="48" HorizontalTextAlignment="Center" />
                        <Label Text="No hay propiedades disponibles"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1B1B1F, Dark=#F2F2F2}" />
                        <Label Text="Desliza hacia abajo para actualizar."
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#6B6F76, Dark=#A0A4AB}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PropertyCardItem">
                        <Border Style="{StaticResource CardStyle}">
                            <VerticalStackLayout Spacing="0">

                                <!-- Imagen principal (miniatura del backend) con placeholder si no hay foto -->
                                <Grid HeightRequest="200"
                                      BackgroundColor="{AppThemeBinding Light=#E4E7EB, Dark=#2A2A30}">
                                    <Label Text="🏠"
                                           FontSize="40"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding HasNoImage}" />
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasImage}"
                                           SemanticProperties.Description="{Binding Title}" />

                                    <!-- Etiqueta Venta / Alquiler -->
                                    <Border HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            Margin="12"
                                            Padding="10,4"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#CC000000">
                                        <Label Text="{Binding OperationText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Padding="16" Spacing="6">
                                    <Label Text="{Binding PriceText}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />

                                    <Label Text="{Binding Title}"
                                           FontSize="16"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light=#1B1B1F, Dark=#F2F2F2}" />

                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="📍" FontSize="14" VerticalOptions="Center" />
                                        <Label Text="{Binding LocationText}"
                                               FontSize="14"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#6B6F76, Dark=#A0A4AB}" />
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding SpecsText}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#6B6F76, Dark=#A0A4AB}" />

                                    <!-- El comando vive en la página (ViewModel), no en el item -->
                                    <Button Text="Ver detalles"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,8,0,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PropertiesListViewModel}}, Path=ViewDetailsCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Spinner al cargar la página siguiente -->
                <CollectionView.Footer>
                    <ActivityIndicator x:DataType="vm:PropertiesListViewModel"
                                       IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       Color="{StaticResource Primary}"
                                       Margin="0,8,0,24" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
