@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudStack Spacing="2">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.MyLocation"
                   OnClick="LocateAsync" Disabled="@busy">
            @if (busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" /> }
            Ubicar por dirección
        </MudButton>

        @if (Latitude is not null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearAsync">Quitar ubicación</MudButton>
        }
    </MudStack>

    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        @if (Latitude is { } lat && Longitude is { } lon)
        {
            @($"Ubicación guardada ({lat:0.#####}, {lon:0.#####}). Arrastra el pin o toca el mapa para afinarla.")
        }
        else
        {
            @:Sin ubicación: la propiedad no aparecerá en el mapa de compradores. Usa el botón o toca el mapa.
        }
    </MudText>

    <div id="@_id" style="height:340px; border-radius:12px; overflow:hidden; border:1px solid var(--mud-palette-lines-default)"></div>
</MudStack>

@code {
    private sealed record GeoResult(double Lat, double Lon, bool Approximate);

    [Parameter] public double? Latitude { get; set; }
    [Parameter] public EventCallback<double?> LatitudeChanged { get; set; }
    [Parameter] public double? Longitude { get; set; }
    [Parameter] public EventCallback<double?> LongitudeChanged { get; set; }

    /// <summary>Dirección completa ("calle, ciudad, provincia"). Si no se encuentra, se prueba con FallbackQuery.</summary>
    [Parameter] public string? Query { get; set; }
    [Parameter] public string? FallbackQuery { get; set; }

    private readonly string _id = $"picker-{Guid.NewGuid():N}";
    private DotNetObjectReference<LocationPicker>? _ref;
    private bool busy;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("rePicker.init", _id, _ref, Latitude, Longitude);
    }

    /// <summary>Lo invoca el JavaScript al soltar el pin o tocar el mapa.</summary>
    [JSInvokable]
    public async Task OnPinMoved(double lat, double lon) => await SetPositionAsync(lat, lon);

    private async Task SetPositionAsync(double lat, double lon)
    {
        Latitude = lat;
        Longitude = lon;
        await LatitudeChanged.InvokeAsync(lat);
        await LongitudeChanged.InvokeAsync(lon);
        StateHasChanged();
    }

    private async Task LocateAsync()
    {
        var queries = new List<string>();
        if (!string.IsNullOrWhiteSpace(Query)) queries.Add($"{Query}, Argentina");
        if (!string.IsNullOrWhiteSpace(FallbackQuery)) queries.Add($"{FallbackQuery}, Argentina");

        if (queries.Count == 0)
        {
            Snackbar.Add("Completa la calle y la ciudad antes de ubicar.", Severity.Warning);
            return;
        }

        busy = true;
        try
        {
            var found = await JS.InvokeAsync<GeoResult?>("rePicker.geocode", _id, queries);
            if (found is null)
            {
                Snackbar.Add("No encontramos esa dirección. Toca el mapa para ubicarla a mano.", Severity.Warning);
                return;
            }

            await SetPositionAsync(found.Lat, found.Lon);
            if (found.Approximate)
                Snackbar.Add("Ubicación aproximada (centro de la ciudad). Arrastra el pin hasta el lugar exacto.", Severity.Info);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ClearAsync()
    {
        await JS.InvokeVoidAsync("rePicker.clear", _id);
        Latitude = Longitude = null;
        await LatitudeChanged.InvokeAsync(null);
        await LongitudeChanged.InvokeAsync(null);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("rePicker.dispose", _id); }
        catch (JSException) { /* el mapa ya no existe */ }
        _ref?.Dispose();
    }
}
