    "MaxDimension": 1600,
    "ThumbnailDimension": 480,
    "Quality": 80,
    "MaxPixels": 20000000
  },

  "Storage": {
    "Provider": "Supabase",
    "SupabaseUrl": "",
    "SupabaseKey": "",
    "SupabaseBucket": "property-images",
    "LocalRootPath": "uploads",
    "PublicBaseUrl": ""
  },

  "Seed": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": "",
    "SuperAdminName": "Super Admin",
    "DemoData": false,
    "DemoEmail": "socio@demo.test",
    "DemoPassword": ""
  }
